# Supabase connection (Server-side only — never expose SUPABASE_SECRET_KEY to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key

# Supabase public key for browser-side Auth (/admin) with RLS enabled (or SUPABASE_PUBLISHABLE_KEY)
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Resend API key for enquiry email notifications
RESEND_API_KEY=re_your_resend_api_key
