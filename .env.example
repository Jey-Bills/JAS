# Supabase server connection (server-side only; never place these server keys in browser files)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Alternative server key name, if used by the Vercel project:
# SUPABASE_SERVICE_ROLE_KEY=

# Public Supabase key used by the browser for /jas-hub/ authentication with RLS enabled
SUPABASE_ANON_KEY=
# Alternative public key name, if used by the Vercel project:
# SUPABASE_PUBLISHABLE_KEY=

# Resend email notifications
RESEND_API_KEY=
